# Supabase project URL (find at Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe to expose client-side (find at Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role secret key — server-side only, NEVER expose to the client.
# Paste this in from the Supabase dashboard: Project Settings > API > service_role secret.
# Required starting WP3 (server actions that need to bypass RLS); leave blank until then.
SUPABASE_SERVICE_ROLE_KEY=
